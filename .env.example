# ===========================================================================
#  ContextOS - free LLM providers, two-lane routing
#  Copy this file to ".env" and paste in your keys. Every provider below is
#  free with NO credit card (checked 2026-09-24).
#
#  How routing works:
#    SMART lane - strongest free models. Used for code, maths, design,
#                 debugging, multi-part questions.
#    FAST lane  - small quick models. Used for chat, rephrasing, lookups.
#  Each message is scored 0-1 for difficulty (no API call spent on that).
#  If a lane's models are all down, it spills into the other lane. A model
#  that fails is benched for a while (429: 60s, 503: 30s, retired/paywalled:
#  1 hour) so later messages skip it instead of waiting on it.
#
#  Force a lane for one message:  start it with "/smart " or "/fast "
#  Check what works:               RUN.bat -> T   (python -m contextos.live --check)
#  See models your key allows:     RUN.bat -> M   (python -m contextos.live --models)
#
#  One key per provider unlocks BOTH its smart and its fast model.
#  3-4 providers is plenty. Best first picks: Groq, OpenRouter, Cloudflare, Cohere.
# ===========================================================================

# --- Groq ------------------------------------------------------------------
# Fastest by far (~1s replies). 30 req/min, 1,000 req/day per model.
# smart: openai/gpt-oss-120b     fast: openai/gpt-oss-20b
# KEY:  https://console.groq.com/keys
GROQ_API_KEY=

# --- Google AI Studio (Gemini) ---------------------------------------------
# Best quality on the free tier, but Flash models are often "high demand"
# (HTTP 503) at peak hours - the fallback handles that. Pro is paid-only.
# Free prompts may be used for training (outside EU/UK).
# smart: gemini-flash-latest     fast: gemini-flash-lite-latest
# KEY:  https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- NVIDIA build (NIM) ----------------------------------------------------
# 80+ frontier open models on one key. 40 req/min, free credits on signup.
# smart: z-ai/glm-5.3            fast: nvidia/nemotron-3.5-lightning-30b-a3b
# Correct but slow (~30-40 s a reply), so it is a late fallback.
# KEY:  https://build.nvidia.com/  -> sign in -> open any model -> "Get API Key"
NVIDIA_API_KEY=

# --- OpenRouter ------------------------------------------------------------
# One key, 20 free models. 20 req/min, 50 req/day (1,000/day after a one-time
# $10 top-up). Only models ending in ":free" are used - no charges.
# smart: nvidia/nemotron-3-ultra-550b-a55b:free
# fast:  z-ai/glm-5.2:free   (~3 s a reply)
# KEY:  https://openrouter.ai/settings/keys
# FREE MODELS: https://openrouter.ai/models?max_price=0
OPENROUTER_API_KEY=

# --- Cloudflare Workers AI -------------------------------------------------
# 10,000 "neurons"/day free. Needs a token AND your account id.
# smart: @cf/openai/gpt-oss-120b  fast: @cf/openai/gpt-oss-20b
# TOKEN:      https://dash.cloudflare.com/profile/api-tokens
#             ("Create Token" -> template "Workers AI")
# ACCOUNT ID: the long id in your dashboard URL: dash.cloudflare.com/<account_id>
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# --- Mistral ---------------------------------------------------------------
# Free "Experiment" plan. Trains on your data by default. Rate-limits often
# (HTTP 429 = busy, not a bad key).
# smart: mistral-medium-latest   fast: ministral-8b-latest
# KEY:  https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# --- Cohere ----------------------------------------------------------------
# 1,000 calls/month, 20 req/min. NON-COMMERCIAL use only (fine for college).
# smart: command-a-plus-05-2026  fast: command-r7b-12-2024
# KEY:  https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# --- Ollama (your own laptop) ----------------------------------------------
# No key, no limits, works offline. Install, then:  ollama pull llama3.1:8b
# DOWNLOAD: https://ollama.com/download
# Any value turns it on (it is a switch, not a secret).
OLLAMA_API_KEY=

# ===========================================================================
#  Optional settings
# ===========================================================================

# auto = score each message (default) | smart = always smart | fast = always fast
# LLM_ROUTING=auto

# Difficulty at or above this goes to the smart lane (0-1, default 0.5).
# Lower it to use the smart lane more often.
# LLM_ROUTE_THRESHOLD=0.5

# Fallback order inside each lane, left to right. Providers without a key
# are skipped automatically, so you only need these to change priority.
# LLM_SMART_ORDER=groq,openrouter,cloudflare,cohere,gemini,mistral,nvidia
# LLM_FAST_ORDER=groq-fast,openrouter-fast,cloudflare-fast,cohere-fast,gemini-fast,mistral-fast,nvidia-fast,ollama

# Swap any model without touching code. Name = provider in capitals + _MODEL,
# fast lane adds _FAST. Examples:
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# NVIDIA_MODEL=z-ai/glm-5.3-flash
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# ---------------------------------------------------------------------------
#  Not included, and why (so you don't waste time on them):
#   Cerebras   - now needs payment (HTTP 402), trial credit needs a card
#   Together   - no free tier any more, bills before use
#   GitHub Models - shut down on 30 July 2026
#   Anthropic / OpenAI / DeepSeek - paid only. ANTHROPIC_API_KEY still works
#                                   here if you ever add one.
# ---------------------------------------------------------------------------

# Optional: 1 = only use models on this machine (Ollama); nothing leaves the computer.
LLM_LOCAL_ONLY=0
